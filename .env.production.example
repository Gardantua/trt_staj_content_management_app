# Public address. A free DuckDNS subdomain can be used for the first demo.
APP_DOMAIN=example.duckdns.org

# Generate different long random values. Never commit the real .env.production file.
DATABASE_PASSWORD=replace-with-a-long-random-password
LEADERBOARD_DATABASE_PASSWORD=replace-with-another-long-random-password
RABBITMQ_PASSWORD=replace-with-another-long-random-password

# MailerSend SMTP credentials and a sender under a verified domain.
MAILERSEND_SMTP_USERNAME=replace-with-mailersend-smtp-username
MAILERSEND_SMTP_PASSWORD=replace-with-mailersend-smtp-password
MAILERSEND_FROM_ADDRESS=no-reply@example.com

# Enable only for the first successful boot. Then set false and remove the password.
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_DISPLAY_NAME=İlk Yönetici
INITIAL_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
